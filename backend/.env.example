# Copy to backend/.env for local development, then fill in your own values.
# Docker uses backend/.env.docker instead (see the bottom of this file).

# --- required ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<optional default db>
MONGODB_DATABASE_NAME=treasurer

# --- Supabase (Auth + Storage) ----------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>
SUPABASE_SECRET_KEY=<secret / service-role key>

# --- URLs and cookies -------------------------------------------------------
# where the browser loads the app (used by auth redirects and the CSRF origin check)
FRONTEND_URL=http://localhost:5173
# extra comma-separated origins allowed to call the API
ALLOWED_ORIGINS=
# true only when served over HTTPS; browsers drop Secure cookies on plain http
COOKIE_SECURE=false
# the first account to sign in takes over the data made before accounts existed
CLAIM_LEGACY_USER=true

# --- optional: Redis (cache, agent run events). Leave empty to run without it
# local dev; docker-compose sets redis://redis:6379/0 itself
REDIS_URL=redis://localhost:6379/0

# --- optional: Google Drive connect ----------------------------------------
# Fernet key that encrypts stored Google tokens. Losing it means every user reconnects.
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# defaults to http://localhost:8000/api/connect/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# alternative to backend/google_creds/credentials.json (for hosts without the file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=

# --- AI providers -----------------------------------------------------------
# primary chat model
GROQ_API_KEY=
GROQ_MODEL=
# fallback chat model, also used to read images
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
# embeddings for agent memory (only used when the embeddings client is enabled)
GEMINI_API_KEY=
GEMINI_EMBEDDINGS_MODEL=gemini-embedding-2
# optional, not wired into the agent
MISTRAL_API_KEY=
MISTRAL_LLM_MODEL=

# --- Docker Compose only: put these in a root .env, not here ----------------
# FRONTEND_URL=http://localhost:8080
# COOKIE_SECURE=false
# CLAIM_LEGACY_USER=true

# Email (Brevo SMTP) for sign-up verification and password reset codes. SENDER must be verified in Brevo.
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMTP_SENDER=
